# Admin password - change this!
ADMIN_PASSWORD=changeme

# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=please-change-this-secret-key

# Service start time (HH:MM, 24h). Before this time = 準時, after = 遲到
SERVICE_START_TIME=10:00

# Database URL — leave default for SQLite, or use Render PostgreSQL URL
# For Render PostgreSQL: postgresql://user:pass@host/db
DATABASE_URL=sqlite:///attendance.db
